# Formatting rules. Used by editors (clangd format-on-save) and enforced by
# tools/lint.ps1 (pre-push gate + "lint" CI job) on our own code only:
# firmware/devboard/*/App/** and firmware/tests/*.cpp. CubeMX-generated Core/
# and vendor Drivers/ are never formatted.
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
NamespaceIndentation: None
ColumnLimit: 100
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterClass: false
  AfterStruct: false
  AfterEnum: false
  AfterNamespace: false
  BeforeCatch: false
  BeforeElse: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: true
Standard: c++17
PointerAlignment: Left
DerivePointerAlignment: false
IncludeBlocks: Regroup
SortIncludes: true
